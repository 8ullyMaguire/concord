[Unit]
Description=Concord — record one day's instance statistics (R15, §4.13 STAT-3)
Documentation=file:///home/alvaro/concord-deploy/README.md
After=network-online.target
Wants=network-online.target

# One pass, then exit. Not a goroutine in the server on purpose: the server restarts on every
# deploy, and a loop inside it would lose its schedule and re-run the pass on each restart.
# A timer also makes a gap VISIBLE -- a missing day in the series -- where a loop that dies
# with the process leaves no row and no error anywhere.
[Service]
Type=oneshot
ExecStart=/home/alvaro/concord-deploy/statsnapshot
Environment=CONCORD_DB=/home/alvaro/.local/share/concord/concord.db
WorkingDirectory=/home/alvaro/concord-deploy
Nice=10
# A failed pass must be visible in `systemctl --user status` and in the journal; it must NOT
# restart in a loop, because the usual cause is a missing database directory and retrying
# would only repeat it.
SuccessExitStatus=0
