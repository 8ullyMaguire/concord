[Unit]
Description=Concord — mark undecided proposals stale (spec §8.6)
Documentation=file:///home/alvaro/concord-deploy/README.md
After=network-online.target
Wants=network-online.target

# One pass, then exit. Not a goroutine in the server: the server restarts on every deploy, and a
# loop inside it would lose its schedule and re-run on each restart. A timer also makes a failed
# pass VISIBLE -- a non-zero status in `systemctl --user status` and a line in the journal -- where
# a loop that dies with the process leaves nothing anywhere.
[Service]
Type=oneshot
ExecStart=/home/alvaro/concord-deploy/proposalsweep
Environment=CONCORD_DB=/home/alvaro/.local/share/concord/concord.db
WorkingDirectory=/home/alvaro/concord-deploy
Nice=10
# A failure must be visible and must NOT retry in a loop: the usual causes (unwritable database,
# schema drift) are not fixed by running again a second later. The next day's pass retries anyway.
SuccessExitStatus=0
