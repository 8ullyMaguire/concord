[Unit]
Description=Concord — measure each project's upstream repository (R9, §4.5.7.1)
Documentation=file:///home/alvaro/concord-deploy/README.md
After=network-online.target
Wants=network-online.target

# One pass, then exit. Not a goroutine in the server on purpose: the server restarts on every
# deploy, and a loop inside it would re-fetch the whole catalog on each restart while losing the
# schedule in between.
#
# CONCORD_FORGE_TOKEN is read from the environment file so an unauthenticated run (60 req/h on
# GitHub) can be fixed without editing this unit. Without a token the fetcher asks for fewer pull
# requests per repository, which lowers the review sample rather than failing.
[Service]
Type=oneshot
ExecStart=/home/alvaro/concord-deploy/healthsync
Environment=CONCORD_DB=/home/alvaro/.local/share/concord/concord.db
EnvironmentFile=-/home/alvaro/.config/concord/forge-token.env
WorkingDirectory=/home/alvaro/concord-deploy
Nice=10
# A failed pass must be visible in `systemctl --user status` and in the journal; it must NOT
# restart in a loop, because the failure is usually a forge being down and retrying would spend
# the rate limit that the next scheduled pass needs.
SuccessExitStatus=0
